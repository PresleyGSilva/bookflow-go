# Ports
API_PORT=8085
WEB_PORT=3005
DB_PORT=5438

# Postgres (used by docker compose service `db`)
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=bookflow
POSTGRES_DB=bookflow

# Backend (container `api`; points at compose service name `db`)
DATABASE_URL=postgres://bookflow:bookflow@db:5432/bookflow?sslmode=disable
JWT_SECRET=change-me-in-production

# Local backend without compose (db exposed on host port DB_PORT)
# DATABASE_URL=postgres://bookflow:bookflow@localhost:5438/bookflow?sslmode=disable

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8085
